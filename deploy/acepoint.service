[Unit]
Description=AcePoint 羽毛球手势计分系统
Documentation=https://github.com/  https://localhost:8080
# multi-user.target 并不保证 USB 摄像头枚举完成，冷启动时 UVC 设备晚一两秒
# 出现是常见现象。程序自己会容忍少一路（采样率不变，见 engine.run），
# 但仍然建议留出时间给 udev 把设备节点建好。
After=multi-user.target
Wants=multi-user.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/AcePoint
ExecStart=/home/pi/scorer/bin/acepoint -c /home/pi/AcePoint/config.pi.toml

Restart=always
RestartSec=5

# 关键：systemd 默认 10 秒内重启 5 次就把 unit 打成 failed 并**永不再试**。
# 摄像头没枚举出来时程序会立即退出，5 次轻松挤进 10 秒 —— 而这是个无键盘、
# 无网络、只读根文件系统的球场设备，进了 failed 状态只能拔 SD 卡救。
# 更糟的是失败后 Pi 空转约 0.5A，正落在充电宝自动断电的小电流区间，
# 现场会表现成"充电宝坏了"。所以这里明确取消启动限流：永不放弃。
StartLimitIntervalSec=0
StartLimitBurst=0

# 只读根文件系统下日志进 journald 的易失存储，拔电即丢。
# 想留现场记录见 deploy/README.md 里的"持久化日志"一节。
StandardOutput=journal
StandardError=journal
SyslogIdentifier=acepoint

# 供电和散热都吃紧（需求 §3.2 整机预算约 7W）。装盒实测若发现降频或欠压，
# 把下面一行的注释去掉，把识别限制在 3 个核上，给系统留一个核。
# 代价是推理变慢、每路采样率下降，需要重跑 scripts/check_sampling.py 复核参数。
#CPUAffinity=0-2

[Install]
WantedBy=multi-user.target
